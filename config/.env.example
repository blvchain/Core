# ---------------------------------------------------------------------------
# BLVchain Core - example configuration
# Copy this file to config/.env and adjust the values for your node.
# ---------------------------------------------------------------------------

# Database
MONGO_URI=mongodb://localhost:27017/
DB=BLVchain

# Identity of this node (must match an entry in config/dns_seed.json for
# multi-node deployments). 32 hex characters.
SELF_UID=node_1_729ea2f23d456b626df2f27183047912

# Node key for the WebSocket peer-authentication handshake (NET-2).
# Prefer config/node_keys.json (gitignored) keyed by SELF_UID; NODE_PRIVATE_KEY
# overrides it. Generate one with: go run ./cmd/nodekeygen <SELF_UID>
# NODE_PRIVATE_KEY=<64 hex characters>
# NODE_PUBLIC_KEY=<66 hex characters, must match dns_seed.json>

# Ports
WP=:8081
GP=:50051

# Rate limit for gRPC (tokens per second / burst)
READ_DATA_R=0.1
READ_DATA_BURST=30
ADD_DATA_R=0.1
ADD_DATA_BURST=5

# Maximum accepted block payload, in kilobytes
MAX_DATA_SIZE_KB=2048

# --- Smart contracts (BVM) -------------------------------------------------
# Path to the WASM file executed by `bvm.RunBVM` (development helper).
SMART_CONTRACT_PATH=./smart_contracts/smart_contract.wasm
# Directory where uploaded contracts are stored.
SMART_CONTRACT_DIR=smart_contracts
# Wall-clock limit for one contract execution, in seconds.
EXECUTION_TIMEOUT_SECONDS=10
# WASM linear memory cap, in 64 KiB pages (256 pages = 16 MiB).
MAX_MEMORY_PAGES=256
# Largest accepted contract upload, in kilobytes.
MAX_WASM_SIZE_KB=1024

# --- Database operations ---------------------------------------------------
# Timeout for a single Mongo operation, in seconds.
DB_OP_TIMEOUT_SECONDS=10

# --- Validation -----------------------------------------------------------
# Maximum tolerated difference between this node's clock and a client-supplied
# block timestamp, in milliseconds (default 86400000 = 24h). This is a sanity
# bound on new submissions, never a synchronisation or consensus rule.
# TIMESTAMP_SKEW_MS=86400000